&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <0>;
    flavor = "hold-preferred";
};
&lt {
    tapping-term-ms = <280>;
    quick-tap-ms = <0>;
    require-prior-idle-ms = <0>;
    flavor = "hold-preferred";
};

/ {
  keymap {
    compatible = "zmk,keymap";

    BASE {
      bindings = <
        TAB
        Q
        W
        E
        R
        T
        Y
        U
        I
        O
        P
        MINUS
        LCTRL
