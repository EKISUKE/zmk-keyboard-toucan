        LT 2 DOT
        MT RSHIFT SLASH
        MT LSHIFT LANG1
        LT 4 LGUI
        LT 1 SPACE
        MT LCTRL ESC
        BSPC
        LT 2 ENTER
        MT RALT ENTER
      >;
    };

    NAV {
