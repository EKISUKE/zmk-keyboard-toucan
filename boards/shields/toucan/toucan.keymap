        F4
        F5
        F9
        F10
        F11
        F12
        TRANS
        TRANS
        TRANS
        TRANS
        TRANS
        TRANS
        TRANS
        TRANS
      >;
    };

    SYS {
      bindings = <
        TRANS
        TRANS
        7
        8
        9
        TRANS
        TRANS
        LS(LBKT)
        LS(RBKT)
        LS(LG(S))
        PRSC
        TRANS
        TRANS
        TRANS
        4
        5
        6
        TRANS
        LG(TAB)
        LS(9)
        LS(0)
        TRANS
        BSLH
        TRANS
        Studio Unlock
        TRANS
        1
        2
        3
        TRANS
        TRANS
        LBKT
        RBKT
        TRANS
        SEMI
        TRANS
        TRANS
        0
        TRANS
